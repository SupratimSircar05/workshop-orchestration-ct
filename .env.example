# Application
APP_NAME=closing-orchestration-service
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (async URL for SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://cos:cos@localhost:5432/closing_orchestration

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CLOSING_STAGING_ROOT=/tmp/closing-staging

# Intended secrets — DEMO ONLY; rotate before any real deployment
ADMIN_TOKEN=
PARTNER_WEBHOOK_SECRET=

# LOS integration base URL (server-side requests — validate in production)
DEFAULT_CALLBACK_TIMEOUT_SECONDS=10
